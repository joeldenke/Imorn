<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's own manifest is just the application and its launcher activity. Modules add what they need. Every
  permission, query and exported component of the merged manifest ends up in app/badging/debug-badging.txt, which
  CI compares against the built APK (checkDebugBadging).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No network access. ML Kit (Gemini Nano, through AICore on the phone) pulls in Google's datatransport library,
      which asks for INTERNET to send usage statistics. Gemini Nano itself doesn't need the network, and Imorn's
      data stays on the phone, so the permission is removed for every library. Adding it back needs the owner's ok.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:name=".ImornApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Imorn">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
