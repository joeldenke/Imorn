            "anchor": "test",
            "offsetDays": -14
          },
          "links": [
            "trafikverket.korprov"
          ]
        },
        {
          "id": "driving-test",
          "title": {
            "sv": "Uppkörningen",
            "en": "The driving test"
          },
          "at": {
            "anchor": "test",
            "offsetDays": 0
          },
          "links": [
            "trafikverket.korprov"
          ],
          "photoPrompt": {
            "sv": "Spara ett foto från dagen du fick körkortet",
            "en": "Keep a photo from the day you passed"
          }
        }
      ]
