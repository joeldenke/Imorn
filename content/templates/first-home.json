          },
          "at": {
            "anchor": "anchor",
            "offsetMonths": -2
          },
          "links": [
            "konsumenternas.start"
          ]
        },
        {
          "id": "deposit",
          "title": {
            "sv": "Förbered depositionen",
            "en": "Prepare the deposit"
