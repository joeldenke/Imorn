            "anchor": "anchor",
            "offsetMonths": -1
          },
          "links": [
            "konsumenternas.start"
          ]
        }
      ]
    },
    {
      "id": "paperwork",
      "title": {
        "sv": "Papper",
        "en": "Paperwork"
      },
      "steps": [
        {
          "id": "address",
          "title": {
            "sv": "Gör flyttanmälan",
            "en": "Register your move"
          },
          "why": {
            "sv": "Gör det i tid så post och myndigheter hittar dig.",
            "en": "Do it in time so post and authorities can reach you."
          },
          "at": {
            "anchor": "anchor",
            "offsetDays": -7
          },
          "links": [
            "skatteverket.flytt"
          ]
        },
        {
          "id": "utilities",
          "title": {
            "sv": "Teckna el och internet",
            "en": "Set up electricity and internet"
          },
          "why": {
            "sv": "Jämför avtal och säg upp det du inte längre behöver.",
            "en": "Compare deals and cancel what you no longer need."
          },
          "at": {
            "anchor": "anchor",
            "offsetDays": -7
          },
          "links": [
            "elpriskollen.start",
            "energimarknadsbyran.start"
          ]
        }
      ]
    },
    {
      "id": "move-in",
      "title": {
        "sv": "Flytta in",
        "en": "Move in"
      },
      "steps": [
        {
          "id": "pack",
          "title": {
            "sv": "Pack det nödvändigaste först",
            "en": "Pack the essentials first"
          },
          "why": {
            "sv": "Lakan, laddare, tandborste och något att äta.",
            "en": "Sheets, charger, toothbrush and something to eat."
          }
        },
        {
          "id": "meter",
          "title": {
            "sv": "Läs av mätare och fota",
            "en": "Read the meters and take photos"
          },
          "why": {
            "sv": "Ett bra skydd om något ifrågasätts senare.",
            "en": "Good protection if something is questioned later."
          },
          "photoPrompt": {
            "sv": "Fota mätare och tomt hem",
            "en": "Photograph meters and the empty home"
          }
        },
        {
          "id": "first-night",
          "title": {
            "sv": "Fira första natten",
            "en": "Celebrate the first night"
          },
          "why": {
            "sv": "Du behöver inte ha allt klart. Hemmet blir till med tiden.",
            "en": "You do not need everything ready. A home grows with time."
          },
          "at": {
            "anchor": "anchor",
            "offsetDays": 1
          },
          "photoPrompt": {
            "sv": "Fota första kvällen",
            "en": "Photograph the first evening"
          }
        }
      ]
    }
  ]
