          "why": {
            "sv": "Depositionen betalas ofta före inflyttning.",
            "en": "The deposit is often paid before move-in."
          },
          "at": {
            "anchor": "anchor",
            "offsetMonths": -2
          }
        },
        {
          "id": "insurance",
          "title": {
            "sv": "Teckna hemförsäkring",
            "en": "Take out home insurance"
          },
          "why": {
            "sv": "Den ska gälla från dagen du flyttar in.",
            "en": "It should apply from the day you move in."
