      },
      "required": false
    }
  ],
  "phases": [
    {
      "id": "plan",
      "title": {
        "sv": "Planera",
        "en": "Plan"
      },
      "steps": [
        {
          "id": "budget",
          "title": {
            "sv": "Räkna på hyra och fasta kostnader",
            "en": "Work out rent and fixed costs"
          },
          "why": {
            "sv": "Ta med el, internet, försäkring och mat innan du bestämmer dig.",
