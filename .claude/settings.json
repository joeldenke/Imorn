{
  "extraKnownMarketplaces": {
    "android-skills": {
      "source": {
        "source": "github",
        "repo": "android/skills"
      }
    },
    "gradle-skills": {
      "source": {
        "source": "github",
        "repo": "gradle/gradle-skills"
      }
    }
  },
  "enabledPlugins": {
    "android-skills@android-skills": true,
    "gradle-skills@gradle-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/read-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
